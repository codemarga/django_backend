# Django Backend Environment Configuration

# Set to False in production
DEBUG=False

# Generate a secure key, e.g. using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-super-secret-random-key-in-production

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com,localhost,127.0.0.1

# Comma-separated list of CORS origins for frontend
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Comma-separated list of CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://yourdomain.com

# Managed PostgreSQL Database URL (e.g. from Neon, Supabase, Render Postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/codemarga?sslmode=require

# Time zone (default: Asia/Kathmandu)
TIME_ZONE=Asia/Kathmandu

# (Optional) External Judge0 API URL if using a remote judge instead of local execution
JUDGE0_API_URL=http://localhost:2358
